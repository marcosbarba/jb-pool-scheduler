# Zona horaria y persistencia
TZ=Europe/Madrid
SQLITE_DB_PATH=data/pool_schedule.db

# Red Eléctrica de España (ESIOS)
ESIOS_API_TOKEN=tu_token_esios

# Tuya / Smart Life Cloud (Mismas credenciales para ambos dispositivos)
TUYA_ACCESS_ID=tu_access_id
TUYA_ACCESS_SECRET=tu_access_secret
TUYA_ENDPOINT=https://openapi.tuyaeu.com

# Identificadores de dispositivos en Tuya / Smart Life
TUYA_PUMP_DEVICE_ID=tu_device_id_interruptor_bomba
TUYA_TEMP_DEVICE_ID=tu_device_id_sonda_temperatura

# Netatmo API (Protección Antihielo)
NETATMO_CLIENT_ID=tu_netatmo_client_id
NETATMO_CLIENT_SECRET=tu_netatmo_client_secret
NETATMO_REFRESH_TOKEN=tu_netatmo_refresh_token
NETATMO_STATION_MAC=xx:xx:xx:xx:xx:xx

# Umbrales Antihielo (°C)
ANTIFREEZE_TEMP_THRESHOLD=0.0      # Si baja de 1 °C, se activa
ANTIFREEZE_TEMP_HYSTERESIS=0.0     # Debe subir de 2 °C para desactivarse

# Telegram Bot API
TELEGRAM_BOT_TOKEN=tu_bot_token
TELEGRAM_CHAT_ID=123456789
TELEGRAM_NOTIFY_SWITCH_EVENTS=true